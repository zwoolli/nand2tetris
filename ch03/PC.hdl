// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Inc16(in= outReg, out= outInc);
    Mux16(a= outReg, b= outInc, sel= inc, out= outIncMux);
    Mux16(a= outIncMux, b= in, sel= load, out= outLoadMux);
    Mux16(a= outLoadMux, b= false, sel= reset, out= outResetMux);
    Register(in= outResetMux, load= true, out= out, out= outReg);
}